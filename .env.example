# Copy to .env and fill in what you need. Never commit .env.
#
# ONLY GROQ AND/OR GEMINI ARE NEEDED FOR CLOUD AI. Everything else is optional and falls back
# on its own, silently: no key -> the next provider; every key rate-limited -> the next
# provider; nothing reachable -> a local Ollama, then built-in answers from data/ (the
# question bank, role skills, interview tracks). The app never asks for a key on screen.
#
# Tiers are tried in this order (core/ai_router.py). Speed first: Groq, then Gemini, then local.
AI_PROVIDERS=groq,gemini,ollama
# true = turn on live AI. false here keeps the offline demo answers (nothing calls a network).
MOCK_MODE=true

# --- 1. Groq: the fastest cloud tier ------------------------------------------------------------
# One key, or a pool separated by commas; requests take the keys in turn, and a key that hits
# its rate limit rests for 60 s while the next one answers. Keys: console.groq.com/keys
#   GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# (GROQ_API_KEY=gsk_key1 works too, and joins the pool.) Groq limits quota per organisation:
# keys from the same organisation share it. Groq also transcribes spoken answers (Whisper).
GROQ_API_KEYS=
# Model IDs change; never hard-code them. These are Groq's recommended successors to the Llama
# 3.x models it retired on 2026-08-16; verified 2026-10-19 with the real agents.
# Re-check any time: python -m scripts.check_models
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
# Seconds before a request moves on to the next tier. Raise it (e.g. 15) if long answers such
# as a 10-question quiz keep falling through.
GROQ_TIMEOUT_S=4.0

# --- 2. Google Gemini: the high-capacity cloud tier ---------------------------------------------
# One key or a comma-separated pool, rotated like Groq's. Keys: aistudio.google.com/apikey
#   GEMINI_API_KEYS=AIza_key1,AIza_key2
GEMINI_API_KEYS=
# Verified 2026-11-07 against ai.google.dev/gemini-api/docs/models. (gemini-2.5-flash is only
# served to keys that used it before; gemini-2.0-flash was shut down on 2026-06-01.)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=5.0

# --- 3. Ollama: a local model, works with no internet -------------------------------------------
# Install from ollama.com, then: ollama pull llama3.2:3b . Leave the URL blank to skip Ollama.
# A 200 ms ping decides whether it is running; the model stays loaded between requests.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Context and answer budget, small for speed. Raise OLLAMA_NUM_PREDICT (e.g. 1536) if long
# answers come back cut off.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512

# --- Voice (optional) ---------------------------------------------------------------------------
# ElevenLabs speaks interview questions; each clip is cached in data/.audio_cache/ so a question
# is never paid for twice. Blank or failing: the browser's own voice reads it instead.
ELEVENLABS_API_KEY=
# Blank voice = a premade voice; blank model = ElevenLabs' current default model.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- Storage (optional) -------------------------------------------------------------------------
DB_PATH=./data/placementiq.db
# Telemetry for the faculty dashboard always lives in a local SQLite file (TELEMETRY_DB_PATH),
# so pages never wait on the network. Set a hosted PostgreSQL such as Supabase and every record
# is also copied there in the background; one made while offline waits and goes up later. Use
# either name (DATABASE_URL wins). Supabase's pooler URL (port 6543) suits it. Example with
# placeholder credentials:
#   SUPABASE_DB_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
DATABASE_URL=
TELEMETRY_DB_PATH=./data/placement_nexus.db

# --- Behaviour ----------------------------------------------------------------------------------
# Identical plan, critique and rubric requests are answered from data/.ai_cache.json instantly.
AI_CACHE=true
# true: when no provider answers, serve built-in answers. false: show the error instead (the
# evaluation always runs with false and with the cache off).
AI_OFFLINE_FALLBACK=true
MAX_CRITIC_RETRIES=2
# true = recreate the demo student and cohort on start when the database is empty (hosted demos)
SEED_DEMO=false

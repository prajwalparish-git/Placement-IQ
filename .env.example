# Copy to .env. Never commit .env.
# One key: GROQ_API_KEY. Two keys: GROQ_API_KEY_1 serves what a student waits on (interviews,
# bullet polish), GROQ_API_KEY_2 background work (profile, plans, quiz generation, critic); a 429
# on one fails over to the other. Groq limits quota per organisation: a second key from the
# same organisation shares the first one's quota.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Model IDs change; never hard-code them. Verified 2026-10-19 by probing every served
# chat model with the real agents. Re-check any time: python -m scripts.check_models
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
DB_PATH=./data/placementiq.db
MAX_CRITIC_RETRIES=2
# true = canned responses, no network. Default true so nothing burns quota by accident.
MOCK_MODE=true
# true = recreate the demo student on start when the database is empty (hosted demos)
SEED_DEMO=false

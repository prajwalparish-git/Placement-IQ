# Copy to .env. Never commit .env.
GROQ_API_KEY=
# Model IDs change; pick current ones from console.groq.com/docs/models. Never hard-code them.
GROQ_MODEL_LARGE=
GROQ_MODEL_SMALL=
DB_PATH=./data/placementiq.db
MAX_CRITIC_RETRIES=2
# true = canned responses, no network. Default true so nothing burns quota by accident.
MOCK_MODE=true

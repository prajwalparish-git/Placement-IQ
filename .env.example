# Copy to .env. Never commit .env.
GROQ_API_KEY=
# Model IDs change; never hard-code them. Verified 2026-10-19 by probing every served
# chat model with the real agents. Re-check any time: python -m scripts.check_models
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
DB_PATH=./data/placementiq.db
MAX_CRITIC_RETRIES=2
# true = canned responses, no network. Default true so nothing burns quota by accident.
MOCK_MODE=true

# Copy to .env. Never commit .env.
#
# Which AI answers (core/ai_router.py): the providers below are tried in AI_PROVIDERS order.
# One left blank is skipped. One that fails (no network, quota used up, outage) is paused by a
# circuit breaker and the next one answers. If none answers, the offline tier serves fixed
# answers built from data/, so the app never stops working. MOCK_MODE=true skips all of this.
AI_PROVIDERS=gemini,groq,ollama
# true: when no provider answers, serve the offline tier. false: show the error instead
# (the evaluation always runs with false: offline answers would make its results meaningless).
AI_OFFLINE_FALLBACK=true

# --- 1. Google Gemini (primary) -------------------------------------------------------------
# Key: https://aistudio.google.com/apikey . Model IDs change; never hard-code them. Verified
# 2026-11-07 against the Gemini API model list (ai.google.dev/gemini-api/docs/models).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- 2. Groq ----------------------------------------------------------------------------------
# One key: GROQ_API_KEY. Two keys: GROQ_API_KEY_1 serves what a student waits on (interviews,
# bullet polish), GROQ_API_KEY_2 background work (profile, plans, quiz generation, critic); a 429
# on one fails over to the other. Groq limits quota per organisation: a second key from the
# same organisation shares the first one's quota. Groq also transcribes spoken answers
# (Whisper); without a Groq key the student types the answer instead.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Verified 2026-10-19 by probing every served chat model with the real agents.
# Re-check any time: python -m scripts.check_models
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b

# --- 3. Ollama (local, works offline) -------------------------------------------------------
# Install from https://ollama.com, then: ollama pull llama3   (or mistral). Leave the URL blank
# to skip Ollama. The router checks GET /api/tags before using it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Voice (core/speech_router.py) ----------------------------------------------------------
# ElevenLabs speaks interview questions. Blank key, an outage or used-up quota: the browser's
# own voice (Web Speech API) reads the question instead. Key: elevenlabs.io > Profile > API key.
ELEVENLABS_API_KEY=
# Optional. Blank voice = a premade voice; blank model = ElevenLabs' current default model.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- Storage ----------------------------------------------------------------------------------
DB_PATH=./data/placementiq.db
# Telemetry (database/: activity records and the faculty dashboard). Blank = a local SQLite
# file. If PostgreSQL is set but unreachable, telemetry fails over to TELEMETRY_DB_PATH and logs
# it; the app keeps running either way. Example (placeholder credentials):
# DATABASE_URL=postgresql://user:password@localhost:5432/placement_nexus
DATABASE_URL=
TELEMETRY_DB_PATH=./data/placement_nexus.db

# --- Behaviour --------------------------------------------------------------------------------
MAX_CRITIC_RETRIES=2
# true = canned responses, no network. Default true so nothing burns quota by accident.
MOCK_MODE=true
# true = recreate the demo student on start when the database is empty (hosted demos)
SEED_DEMO=false

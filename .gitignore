# --- Secrets ------------------------------------------------------------------------------------
.env

# --- Made by bootstrap.py on each machine (python bootstrap.py) -----------------------------------
/run.sh
/run.ps1
.tools/
.venv/

# --- Python ---------------------------------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# --- Runtime data (recreate with: ./run.sh seed, or .\run.ps1 seed) -------------------------------
data/*.db
data/*.db-journal
data/.ai_cache.json
data/.audio_cache/

# --- Evaluation output (regenerate with: python -m evaluation.run_eval) ---------------------------
evaluation/results/*
!evaluation/results/.gitkeep

# --- Raw question-bank source; the cleaned bank (data/questions/mcq_bank.csv) is committed --------
MCQ.csv*

# --- Planning documents and local working briefs: kept locally, never tracked ---------------------
PlacementIQ_Project_Spec*
docs/PlacementIQ_Project_Spec*
REDESIGN_BRIEF.md
docs/REDESIGN_BRIEF.md
REDESIGN_PROGRESS.md
docs/REDESIGN_PROGRESS.md
/Personal documentation/
Personal Docs/

# --- Screenshot captures: only curated sets are committed, with git add -f ------------------------
docs/design/before/
docs/design/after/

# --- Local tool state: AI-assistant settings and skills, deploy caches ----------------------------
.claude/
.gemini/
.wrangler/

